{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raven-manor.example/schemas/level.schema.json",
  "title": "Raven Manor level catalog",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion","id","title","difficulty","moves","starThresholds","board","objectives"],
    "properties": {
      "schemaVersion": { "const": 3 },
      "id": { "type": "integer", "minimum": 1 },
      "title": { "type": "string", "minLength": 1 },
      "difficulty": { "enum": ["easy","normal","hard","finale"] },
      "moves": { "type": "integer", "minimum": 1 },
      "starThresholds": { "$ref": "#/definitions/starThresholds" },
      "board": { "$ref": "#/definitions/board" },
      "objectives": {
        "type": "array",
        "minItems": 1,
        "items": { "oneOf": [
          { "$ref": "#/definitions/collectObjective" },
          { "$ref": "#/definitions/clearObstacleObjective" }
        ] }
      }
    }
  },
  "definitions": {
    "starThresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["twoStarsMovesLeft","threeStarsMovesLeft"],
      "properties": {
        "twoStarsMovesLeft": { "type": "integer", "minimum": 0 },
        "threeStarsMovesLeft": { "type": "integer", "minimum": 1 }
      }
    },
    "board": {
      "type": "object", "additionalProperties": false,
      "required": ["mask","obstacles"],
      "properties": {
        "mask": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "string", "pattern": "^[01]{8}$" } },
        "obstacles": { "type": "array", "items": { "$ref": "#/definitions/obstacle" } }
      }
    },
    "obstacle": {
      "type": "object", "additionalProperties": false,
      "required": ["row","col","kind","layers"],
      "properties": {
        "row": { "type": "integer", "minimum": 0, "maximum": 7 },
        "col": { "type": "integer", "minimum": 0, "maximum": 7 },
        "kind": { "enum": ["chain","rubble","fog"] },
        "layers": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "collectObjective": {
      "type": "object", "additionalProperties": false,
      "required": ["id","type","tileType","target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "collect" },
        "tileType": { "type": "integer", "minimum": 0, "maximum": 5 },
        "target": { "type": "integer", "minimum": 1 }
      }
    },
    "clearObstacleObjective": {
      "type": "object", "additionalProperties": false,
      "required": ["id","type","obstacleKind","target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "clear-obstacle" },
        "obstacleKind": { "enum": ["chain","rubble","fog"] },
        "target": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
